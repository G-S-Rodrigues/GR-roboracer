<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racing_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and the trajectory/boundary/TF support node that compose the vertical slice.</description>
  <maintainer email="guilherme6821@gmail.com">Guilherme Rodrigues</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>racing_controller_baseline</exec_depend>
  <exec_depend>racing_interfaces</exec_depend>
  <exec_depend>racing_metrics</exec_depend>
  <exec_depend>racing_recording</exec_depend>
  <exec_depend>racing_safety_supervisor</exec_depend>
  <exec_depend>racing_sim_gym_jax</exec_depend>
  <exec_depend>racing_vehicle_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
