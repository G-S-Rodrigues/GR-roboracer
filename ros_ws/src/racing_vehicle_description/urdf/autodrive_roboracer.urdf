        <mesh filename="package://racing_vehicle_description/meshes/autodrive_roboracer/wheel_fl.stl"/>
      </geometry>
      <material name="ad_1b1b1b"/>
    </visual>
  </link>
  <joint name="rear_axle_to_left_front_wheel" type="fixed">
    <parent link="rear_axle"/>
    <child link="left_front_wheel"/>
