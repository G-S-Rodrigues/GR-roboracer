    <color rgba="0.9804 0.8902 0.4941 1.0"/>
  </material>
  <material name="ad_ffba00">
    <color rgba="1.0000 0.7294 0.0000 1.0"/>
  </material>
  <material name="ad_ffdd75">
    <color rgba="1.0000 0.8667 0.4588 1.0"/>
  </material>
  <material name="ad_ffffff">
    <color rgba="1.0000 1.0000 1.0000 1.0"/>
  </material>

  <link name="base_link"/>

  <link name="rear_axle">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/autodrive_roboracer/chassis_000000.stl"/>
