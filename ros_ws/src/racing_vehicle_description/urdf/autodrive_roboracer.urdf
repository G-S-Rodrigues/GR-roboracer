<?xml version="1.0"?>
<!--
  RViz-only AutoDRIVE RoboRacer description, drawn from AutoDRIVE's own model
  (meshes/autodrive_roboracer/, imported by scripts/import_autodrive_meshes.py;
  provenance and BSD-2 licence in meshes/NOTICE.md). Selected by the vehicle
  through urdf/descriptions.yaml. Every joint is fixed; no node publishes
  joint states. No Gazebo, sensor, plugin or actuator-coupling elements.

  Numbers (AutoDRIVE, config/vehicles/autodrive_roboracer/source.yaml):
  base_link is the CoG, lr = 0.15532 ahead of the rear axle at h = 0.07354.
  rear_axle is its fixed child at (-lr, 0, -h): the ground point under the
  rear-axle midpoint, where every mesh is authored. The axle centre is
  0.0592 m above it (h minus the CoG's 0.01434 m above the axle). The lidar
  is 0.2733 m ahead of and 0.096 m above the axle centre (0.1552 above the
  ground point). The front axle sits 0.010 m higher than the rear one (the
  prefab); the wheels are static, with the front wheels straight.
-->
<robot name="autodrive_roboracer">
  <material name="ad_000000">
    <color rgba="0.0000 0.0000 0.0000 1.0"/>
  </material>
  <material name="ad_1a1a1a">
    <color rgba="0.1020 0.1020 0.1020 1.0"/>
  </material>
  <material name="ad_1b1b1b">
    <color rgba="0.1059 0.1059 0.1059 1.0"/>
  </material>
