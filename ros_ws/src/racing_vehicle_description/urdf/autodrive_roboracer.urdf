  </link>
  <joint name="base_link_to_rear_axle" type="fixed">
    <parent link="base_link"/>
    <child link="rear_axle"/>
    <origin xyz="-0.15532 0 -0.07354" rpy="0 0 0"/>
  </joint>

  <link name="lidar">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/autodrive_roboracer/lidar.stl"/>
      </geometry>
      <material name="ad_1a1a1a"/>
    </visual>
  </link>
  <joint name="rear_axle_to_lidar" type="fixed">
    <parent link="rear_axle"/>
    <child link="lidar"/>
    <origin xyz="0.2733 0 0.1552" rpy="0 0 0"/>
  </joint>

  <link name="left_rear_wheel">
