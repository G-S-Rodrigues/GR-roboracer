<?xml version="1.0"?>
<!--
  RViz-only F1TENTH description. Every joint is fixed and no node publishes
  joint states, so the car sits motionless at base_link: a static model for
  inspecting geometry/placement (see launch/display.launch.py). No Gazebo,
  sensor, plugin, or actuator-coupling elements (a spec non-goal here).

  Joint offsets are the source of truth for vehicle geometry and MUST stay put:
  wheelbase 0.33 m (config wheelbase), track 0.236 m (0.118 m each side),
  wheel radius 0.058 m.

  Frames: base_link is the gym's centre of gravity at height h (0.074 m), the
  point the sim publishes as base_link, 0.17145 m (lr) ahead of the rear axle.
  rear_axle is its fixed child at (-lr, 0, -h): the ground point under the
  rear-axle midpoint. The drawing was authored there, so every mesh link hangs
  off rear_axle with its original origin (see scripts/generate_f1tenth_meshes.py)
  and renders exactly where it was generated. The URDF's wheelbase is 0.33 m,
  the gym's is 0.3302.

  All meshes are cosmetic.

  Mesh provenance is documented in meshes/NOTICE.md: hokuyo.stl (the LIDAR),
  left_wheel.stl and right_wheel.stl come from f1tenth-dev/simulator (Apache
  2.0). Everything else (chassis, Jetson board, battery, suspension A-arms,
  shocks, hubs, camera, motors) is originally generated by
  scripts/generate_f1tenth_meshes.py and carries no license concern.

  Run scripts/render_urdf.py after any urdf/mesh edit to sanity-check
  proportions against a reference photo without a live RViz session.
-->
<robot name="f1tenth">

  <material name="laser_grey">
    <color rgba="0.25 0.25 0.27 1.0"/>
  </material>
  <material name="mount_grey">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>
  <material name="chassis_grey">
    <color rgba="0.18 0.18 0.22 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="jetson_green">
    <color rgba="0.06 0.45 0.25 1.0"/>
  </material>
  <material name="battery_black">
    <color rgba="0.08 0.08 0.10 1.0"/>
  </material>
  <material name="camera_dark">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>
  <material name="suspension_blue">
    <color rgba="0.15 0.35 0.65 1.0"/>
  </material>
  <material name="motor_metal">
    <color rgba="0.32 0.32 0.34 1.0"/>
  </material>

  <link name="base_link"/>

  <link name="rear_axle">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>
  <joint name="base_link_to_rear_axle" type="fixed">
    <parent link="base_link"/>
    <child link="rear_axle"/>
    <origin xyz="-0.17145 0 -0.074" rpy="0 0 0"/>
  </joint>

  <link name="jetson_board">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/jetson_board.stl"/>
      </geometry>
      <material name="jetson_green"/>
    </visual>
  </link>
  <joint name="rear_axle_to_jetson_board" type="fixed">
    <parent link="rear_axle"/>
    <child link="jetson_board"/>
  </joint>

  <link name="battery_pack">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/battery_pack.stl"/>
      </geometry>
      <material name="battery_black"/>
    </visual>
  </link>
  <joint name="rear_axle_to_battery_pack" type="fixed">
    <parent link="rear_axle"/>
    <child link="battery_pack"/>
  </joint>

  <link name="camera">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/camera_box.stl"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
  </link>
  <joint name="rear_axle_to_camera" type="fixed">
    <parent link="rear_axle"/>
    <child link="camera"/>
  </joint>

  <link name="left_rear_wheel">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/left_wheel.stl" scale="1.16 1.16 1"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="rear_axle_to_left_rear_wheel" type="fixed">
    <parent link="rear_axle"/>
    <child link="left_rear_wheel"/>
    <origin xyz="0 0.118 0.058" rpy="1.5708 0 0"/>
  </joint>

  <link name="right_rear_wheel">
    <visual>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/right_wheel.stl" scale="1.16 1.16 1"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="rear_axle_to_right_rear_wheel" type="fixed">
    <parent link="rear_axle"/>
    <child link="right_rear_wheel"/>
    <origin xyz="0 -0.118 0.058" rpy="1.5708 0 0"/>
  </joint>

  <link name="motor_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/motor_left.stl"/>
      </geometry>
      <material name="motor_metal"/>
    </visual>
  </link>
  <joint name="rear_axle_to_motor_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="motor_left"/>
  </joint>

  <link name="motor_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/motor_right.stl"/>
      </geometry>
      <material name="motor_metal"/>
    </visual>
  </link>
  <joint name="rear_axle_to_motor_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="motor_right"/>
  </joint>

  <link name="rear_suspension_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_susp_left.stl"/>
      </geometry>
      <material name="suspension_blue"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_suspension_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_suspension_left"/>
  </joint>

  <link name="rear_suspension_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_susp_right.stl"/>
      </geometry>
      <material name="suspension_blue"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_suspension_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_suspension_right"/>
  </joint>

  <link name="rear_shock_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_shock_left.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_shock_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_shock_left"/>
  </joint>

  <link name="rear_shock_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_shock_right.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_shock_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_shock_right"/>
  </joint>

  <link name="rear_hub_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_hub_left.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_hub_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_hub_left"/>
  </joint>

  <link name="rear_hub_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/rear_hub_right.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_rear_hub_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="rear_hub_right"/>
  </joint>

  <link name="left_steering_hinge"/>
  <joint name="rear_axle_to_left_steering_hinge" type="fixed">
    <parent link="rear_axle"/>
    <child link="left_steering_hinge"/>
    <origin xyz="0.33 0.118 0.058" rpy="0 0 0"/>
  </joint>

  <link name="right_steering_hinge"/>
  <joint name="rear_axle_to_right_steering_hinge" type="fixed">
    <parent link="rear_axle"/>
    <child link="right_steering_hinge"/>
    <origin xyz="0.33 -0.118 0.058" rpy="0 0 0"/>
  </joint>

  <link name="left_front_wheel">
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/left_wheel.stl" scale="1.16 1.16 1"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="left_steering_hinge_to_left_front_wheel" type="fixed">
    <parent link="left_steering_hinge"/>
    <child link="left_front_wheel"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
  </joint>

  <link name="right_front_wheel">
    <visual>
      <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/right_wheel.stl" scale="1.16 1.16 1"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
  </link>
  <joint name="right_steering_hinge_to_right_front_wheel" type="fixed">
    <parent link="right_steering_hinge"/>
    <child link="right_front_wheel"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
  </joint>

  <link name="front_suspension_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_susp_left.stl"/>
      </geometry>
      <material name="suspension_blue"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_suspension_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_suspension_left"/>
  </joint>

  <link name="front_suspension_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_susp_right.stl"/>
      </geometry>
      <material name="suspension_blue"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_suspension_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_suspension_right"/>
  </joint>

  <link name="front_shock_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_shock_left.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_shock_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_shock_left"/>
  </joint>

  <link name="front_shock_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_shock_right.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_shock_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_shock_right"/>
  </joint>

  <link name="front_hub_left">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_hub_left.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_hub_left" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_hub_left"/>
  </joint>

  <link name="front_hub_right">
    <visual>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/front_hub_right.stl"/>
      </geometry>
      <material name="mount_grey"/>
    </visual>
  </link>
  <joint name="rear_axle_to_front_hub_right" type="fixed">
    <parent link="rear_axle"/>
    <child link="front_hub_right"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0.0065" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://racing_vehicle_description/meshes/hokuyo.stl"
               scale="1 1 1"/>
      </geometry>
      <material name="laser_grey"/>
    </visual>
  </link>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.275 0.0 0.031" rpy="0 0 0"/>
  </joint>

</robot>
