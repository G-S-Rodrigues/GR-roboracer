{
    "name": "GR-roboracer",
    "dockerComposeFile": [
        "../docker/docker-compose.yaml",
        "docker-compose.override.yaml"
    ],
    "service": "dev",
    "workspaceFolder": "/ws",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "GR-roboracer": {
                        "path": "bash",
                        "args": [
                            "--rcfile",
                            "/ws/setup.sh",
                            "-i"
                        ]
                    }
                },
                "terminal.integrated.defaultProfile.linux": "GR-roboracer"
            }
        }
    },
    "shutdownAction": "stopCompose"
}
